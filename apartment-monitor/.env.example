# Slack bot token from OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token from Socket Mode with connections:write.
SLACK_APP_TOKEN=xapp-your-app-token

# Optional fallback notification channel. Prefer running `apt bind here` after the bot joins a channel.
SLACK_CHANNEL_ID=

# Docker uses /data/config.yaml. The venv deploy script maps this to ./data/config.yaml.
CONFIG_PATH=/data/config.yaml
